{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miniappdibash",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot", "/hooks/*", "/setup/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notpanel",
      "database_id": "bc931244-329a-45ed-a04e-fedb63ff40f2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BOT_TOKEN": "8596567661:AAFnrD0Xfn3RTsuZpsK6lzawmFlPVaLKyZg",
    "DEV_FAKE_USER_ID": "",
    "OWNER_IDS": "7062424671"
  }
}
